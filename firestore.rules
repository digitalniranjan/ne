rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function admin(){
      return request.auth != null && request.auth.token.email == "piyushkrjaiswal99@gmail.com";
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if admin();
    }

    match /khata_customers/{id} {
      allow read, write: if admin();
    }

    match /khata_entries/{id} {
      allow read, write: if admin();
    }

    // Public website needs to read the public site logo/settings;
    // only the authorised admin can change them.
    match /settings/site {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /settings/{id} {
      allow read, write: if admin();
    }
  }
}
