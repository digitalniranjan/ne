rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function admin(){
      return request.auth != null && request.auth.token.email == "piyushkrjaiswal99@gmail.com";
    }
    function imageWrite(){
      return admin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /khata/{customerId}/{fileName} {
      allow read: if admin();
      allow create, update: if imageWrite();
      allow delete: if admin();
    }

    match /media/{fileName} {
      allow read: if true;
      allow create, update: if imageWrite();
      allow delete: if admin();
    }

    match /products/{fileName} {
      allow read: if true;
      allow create, update: if imageWrite();
      allow delete: if admin();
    }

    match /site/{fileName} {
      allow read: if true;
      allow create, update: if imageWrite();
      allow delete: if admin();
    }
  }
}
