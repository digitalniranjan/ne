      const adminPanelBtn = document.getElementById('adminPanelBtn');

      if (user) {
        guestActions.style.display = 'none';
        loggedInActions.style.display = 'flex';
        if (user.email && user.email.toLowerCase() === ADMIN_EMAIL.toLowerCase()) {
          userNameLabel.innerText = "Admin: " + (user.displayName || "Piyush");
          adminPanelBtn.style.display = 'inline-flex';
          switchView('admin');
        } else {
          userNameLabel.innerText = user.displayName || "Customer";
          adminPanelBtn.style.display = 'none';
          switchView('customer');
        }
      } else {
        guestActions.style.display = 'block';
        loggedInActions.style.display = 'none';
        switchView('customer');
      }
    });

    function renderCatalog() {
      const container = document.getElementById('productGridContainer');
      container.innerHTML = catalog.map(p => `
        <div class="product-card">
          <div class="card-img-wrap">
            <span class="tag-brand">GENUINE</span>
            <img src="${p.img}" alt="${p.title}" onerror="this.src='https://via.placeholder.com/300x200?text=Product'">
          </div>
          <div class="card-body">
            <span class="product-category">${p.category}</span>
            <h4 class="product-title">${p.title}</h4>
            <p class="product-specs">${p.specs}</p>
            <div class="card-footer">
              <span class="product-price">${p.price}</span>
              <div style="display:flex; gap:4px;">
                <button onclick="addToCart(${p.id})" class="btn btn-outline" style="font-size:11px; padding:5px 8px;">Cart</button>
                <button onclick="quickOrderNow(${p.id})" class="btn btn-primary" style="font-size:11px; padding:5px 10px;">Order</button>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    }

    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    function logoutSession() {
      auth.signOut().then(() => alert("Logged out safely."));
    }

    function switchView(view) {
      const user = auth.currentUser;
      if (view === 'admin') {
        if (!user || user.email.toLowerCase() !== ADMIN_EMAIL.toLowerCase()) {
          alert("Sirf Admin hi access kar sakte hain.");
          return;
        }
      }
      document.getElementById('customerView').style.display = (view === 'customer') ? 'block' : 'none';
      document.getElementById('adminView').style.display = (view === 'admin') ? 'block' : 'none';
      if (view === 'admin') {
        renderAdminOrders();
        renderUserLogs();
      }
    }

    function handleProductCreation(e) {
      e.preventDefault();
      catalog.unshift({
        id: Date.now(),
        title: document.getElementById('pName').value,
        category: document.getElementById('pCategory').value,
        price: document.getElementById('pPrice').value,
        img: document.getElementById('pImg').value,
        specs: document.getElementById('pSpecs').value
      });
      localStorage.setItem('niranjan_corp_catalog', JSON.stringify(catalog));
      renderCatalog();
      closeModal('addProductModal');
      alert("Product added!");
    }

    // Initialize
    window.addEventListener('DOMContentLoaded', () => {
      applySettings();
      renderCatalog();
      renderNotifications();
      updateCartUI();
      renderUserLogs();
      renderAdminOrders();

      let visits = parseInt(localStorage.getItem('niranjan_site_visits') || "140") + 1;
      localStorage.setItem('niranjan_site_visits', visits);
      document.getElementById('statTotalVisits').innerText = visits;

      setTimeout(dismissPreloader, 1400);
    });
  </script>
</body>
</html>
