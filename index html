      document.getElementById('notiBadgeCount').innerText = notifications.length;
      const box = document.getElementById('notiCenterContainer');
      box.innerHTML = notifications.map(n => `
        <div class="noti-item">
          <h5><i class="fa fa-info-circle" style="color:var(--primary-color);"></i> ${n.title}</h5>
          <p>${n.content}</p>
          <small>${n.time}</small>
        </div>
      `).join('');
    }

