      currentSettings.gstin = document.getElementById('settingGstin').value.trim();
      currentSettings.address = document.getElementById('settingAddress').value.trim();

      localStorage.setItem('niranjan_site_settings', JSON.stringify(currentSettings));
      applySettings();
      alert("Settings saved!");
    }

