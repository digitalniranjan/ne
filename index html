      const product = catalog.find(p => p.id === productId);
      if (!product) return;
      cart.push(product);
      localStorage.setItem('niranjan_user_cart', JSON.stringify(cart));
      updateCartUI();
      alert(product.title + " added to Cart!");
    }

    function quickOrderNow(productId) {
      const product = catalog.find(p => p.id === productId);
      if (!product) return;
      cart = [product];
      localStorage.setItem('niranjan_user_cart', JSON.stringify(cart));
      updateCartUI();
      openOrderCheckoutModal();
    }

    function updateCartUI() {
      document.getElementById('cartBadgeCount').innerText = cart.length;
      const list = document.getElementById('cartItemsList');
      if (cart.length === 0) {
        list.innerHTML = `<p style="text-align:center; color:#94a3b8; padding:15px;">Your cart is empty.</p>`;
        document.getElementById('cartTotalSummary').innerText = "";
        return;
      }
      list.innerHTML = cart.map((item, idx) => `
        <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid #f1f5f9;">
          <div>
            <b>${item.title}</b>
            <div style="font-size:11px; color:var(--text-muted);">${item.price}</div>
          </div>
          <button onclick="removeFromCart(${idx})" style="color:red; border:none; background:none; cursor:pointer;"><i class="fa fa-trash"></i></button>
        </div>
      `).join('');
      document.getElementById('cartTotalSummary').innerText = "Total: " + cart.length + " item(s)";
    }

