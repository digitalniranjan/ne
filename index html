      const val = document.getElementById('adminTickerInput').value.trim();
      if (!val) return;
      currentSettings.headlineTicker = val;
      localStorage.setItem('niranjan_site_settings', JSON.stringify(currentSettings));
      document.getElementById('displayHeadlineTicker').innerText = val;
      alert("Headline updated!");
